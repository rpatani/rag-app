# --- Postgres ---
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword

# --- Vector store backend ---
# Currently supported: "pgvector"
VECTOR_STORE_BACKEND=pgvector

# --- Embedding backend ---
# "local"  -> sentence-transformers (all-MiniLM-L6-v2, 384 dims, runs on CPU, no API key needed)
# "openai" -> OpenAI text-embedding-3-small (1536 dims, requires OPENAI_API_KEY)
EMBEDDER_BACKEND=local
EMBEDDING_DIM=384

# --- LLM backend ---
# "openai" -> requires OPENAI_API_KEY
# "ollama" -> requires a running Ollama server (see README)
LLM_BACKEND=openai
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# --- Reranker ---
# "cross_encoder" -> cross-encoder/ms-marco-MiniLM-L-6-v2 (local, CPU, ~70MB)
# "none"          -> passthrough, top_k chunks passed straight to LLM
RERANKER_BACKEND=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=3      # chunks sent to LLM after reranking

# --- Retrieval / chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=10              # candidates fetched from vector store before reranking

# --- Ingestion ---
DOCUMENTS_DIR=/data/documents
